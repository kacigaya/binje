{
  "name": "binje",
  "version": "0.14.0",
  "private": true,
  "workspaces": [
    "apps/mobile"
  ],
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:instant": "NEXT_INSTANT_TEST=1 next build",
    "start": "next start",
    "lint": "eslint",
    "test": "bash -lc 'shopt -s globstar; bun test lib/**/*.test.ts app/**/*.test.ts'",
    "test:dependencies": "node --test scripts/dependency-security.test.mjs",
    "test:instant": "bun run build:instant && playwright test e2e/instant.spec.ts",
    "test:e2e": "bun run build:instant && playwright test",
    "mobile:start": "bun --cwd apps/mobile start",
    "mobile:android": "bun --cwd apps/mobile android",
    "mobile:ios": "bun --cwd apps/mobile ios",
    "mobile:lint": "bun --cwd apps/mobile lint",
    "mobile:test": "bun --cwd apps/mobile test",
    "mobile:typecheck": "bun --cwd apps/mobile typecheck"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "clsx": "^2.1.1",
    "hls.js": "^1.6.16",
    "lucide": "^1.48.0",
    "lucide-react": "^1.56.0",
    "morphicons": "^1.7.0",
    "motion": "^13.1.0",
    "next": "16.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@next/playwright": "16.4.2",
    "@playwright/test": "1.62.1",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "@hono/node-server": "^1.19.15",
    "brace-expansion": "1.1.21",
    "fast-uri": "^3.1.8",
    "hono": "^4.13.7",
    "ip-address": "^10.7.4",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "sharp": "^0.35.5",
    "undici": "^7.29.1",
    "qs": "^6.16.0",
    "body-parser": "^2.3.0",
    "uuid": "^11.1.1",
    "@humanfs/node": "^0.16.8",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@xmldom/xmldom": "^0.9.12",
    "baseline-browser-mapping": "^2.11.0",
    "browserslist": "^4.28.7",
    "compression": "^1.8.2",
    "decode-uri-component": "^0.5.0",
    "image-size": "^2.0.4",
    "proxy-addr": "^2.0.8",
    "shell-quote": "^1.11.0",
    "source-map-js": "^1.2.2"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
