[Unit]
Description=b!nje Vidcore browser resolver
Wants=network-online.target
After=network-online.target docker.service gluetun.service

[Service]
Type=simple
User=binje-resolver
Group=binje-resolver
WorkingDirectory=/opt/binje-vidcore-resolver
EnvironmentFile=/etc/binje-vidcore-resolver/environment
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/xvfb-run -a /usr/bin/python3 /opt/binje-vidcore-resolver/vidcore_resolver.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=tmpfs
StateDirectory=binje-vidcore
StateDirectoryMode=0700
CacheDirectory=binje-vidcore
CacheDirectoryMode=0700
Environment=HOME=/var/lib/binje-vidcore
Environment=XDG_CACHE_HOME=/var/cache/binje-vidcore
MemoryMax=1536M
TasksMax=512

[Install]
WantedBy=multi-user.target
